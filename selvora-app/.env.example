# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# URL of the backend API server.
# In production, leave VITE_API_URL empty when using Vercel rewrites.
VITE_API_URL=http://localhost:3000

# Direct backend URL used only to start Discord OAuth.
# In local dev this can match VITE_API_URL.
VITE_API_DIRECT_URL=http://localhost:3000
