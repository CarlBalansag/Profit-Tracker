# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# URL of the backend API server.
# In production, leave VITE_API_URL empty when using Vercel rewrites.
VITE_API_URL=http://localhost:3000

# Direct backend URL used only to start Discord OAuth.
# In local dev this can match VITE_API_URL.
VITE_API_DIRECT_URL=http://localhost:3000

# Public Firebase web configuration. NEVER put a service-account private key here.
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_SIGNUP_ENABLED=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# LOCAL TESTS ONLY: VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
