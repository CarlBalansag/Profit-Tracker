{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.profittracker.carltechs.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://api.profittracker.carltechs.com/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.profittracker.carltechs.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
