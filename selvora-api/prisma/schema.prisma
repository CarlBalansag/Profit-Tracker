// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String           @id @default(uuid())
  discord_id             String?          @unique
  username               String?
  email                  String           @unique
  auth_provider          String?
  accounting_preferences String?
  tutorial_seen          Boolean          @default(false)
  inventories            Inventory[]
  payment_methods        PaymentMethod[]
  expenses               Expense[]
  recurring_expenses     RecurringExpense[]
  accounts               Account[]
  platforms              Platform[]
  goals                  Goal[]
  product_notes          ProductNote[]
  calendar_events        CalendarEvent[]
  calendar_token         String?          @unique
  local_credential       LocalCredential?
  login_disabled         Boolean          @default(false)
  firebase_identity      FirebaseIdentity?
  schedule_c_enabled     Boolean          @default(false)
  buyers                 Buyer[]
  invoices               Invoice[]
}

model FirebaseIdentity {
  id          String @id @default(uuid())
  project_id  String
  firebase_uid String
  user_id     String @unique
  email       String
  user        User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sessions    FirebaseSession[]
  @@unique([project_id, firebase_uid])
}

model FirebaseSession {
  fingerprint String @id
  identity_id String
  identity FirebaseIdentity @relation(fields: [identity_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked Boolean @default(false)
  @@index([expires_at])
}

model AuthIntent {
  id String @id @default(uuid())
  proof_hash String
  session_hash String
  purpose String
  user_id String?
  credential_version Int?
  expires_at DateTime
  consumed Boolean @default(false)
  @@index([expires_at])
}

model MigrationApproval {
  id String @id @default(uuid())
  user_id String
  project_id String
  firebase_uid String
  expires_at DateTime
  consumed Boolean @default(false)
  @@index([user_id, project_id, firebase_uid])
}

model AuthAttemptBucket {
  key String @id
  count Int @default(1)
  expires_at DateTime
  @@index([expires_at])
}

model LocalCredential {
  user_id              String   @id
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email                String   @unique
  password_hash        String
  must_change_password Boolean  @default(true)
  temporary_expires_at DateTime?
  version              Int      @default(1)
  disabled             Boolean  @default(false)
}

model Inventory {
  id                    String         @id @default(uuid())
  user_id               String
  user                  User           @relation(fields: [user_id], references: [id])
  product_name          String
  vendor_id             String?
  vendor                Platform?      @relation(fields: [vendor_id], references: [id])
  payment_method_id     String?
  payment_method        PaymentMethod? @relation(fields: [payment_method_id], references: [id])
  purchase_date         DateTime
  received_date         DateTime?
  unit_purchase_cost    Float
  unit_purchase_cost_decimal Decimal?  @db.Decimal(19, 2)
  qty_purchased         Int
  qty_on_hand           Int
  status                String         @default("PURCHASED")
  // Status-workflow rework (additive). `status` above stays authoritative until
  // a later checkpoint moves routes onto these fields. A NULL receiving_status
  // means "not yet backfilled" -- see scripts/migrateStatusWorkflow.js.
  receiving_status      String?
  is_listed             Boolean        @default(false)
  received_at           DateTime?
  cancelled_at          DateTime?
  correction_note       String?
  sales_tax             Float          @default(0)
  sales_tax_decimal     Decimal?       @db.Decimal(19, 2)
  shipping_cost_inbound Float          @default(0)
  shipping_cost_inbound_decimal Decimal? @db.Decimal(19, 2)
  fees                  Float          @default(0)
  fees_decimal          Decimal?       @db.Decimal(19, 2)
  cashback_earned       Float          @default(0)
  cashback_earned_decimal Decimal?     @db.Decimal(19, 2)
  cashback_rate         Float?
  cashback_rate_decimal Decimal?       @db.Decimal(9, 6)
  gift_card_amount      Float          @default(0)
  gift_card_amount_decimal Decimal?    @db.Decimal(19, 2)
  order_number          String?
  tracking_number       String?
  tracking_info         Json?
  category              String?
  receipt_url           String?
  tax_exempt            Boolean        @default(false)
  created_at            DateTime       @default(now())
  sales                 Sales[]

  @@index([user_id])
  @@index([user_id, purchase_date])
  @@index([tax_exempt])
}

model Sales {
  id                  String    @id @default(uuid())
  inventory_id        String
  inventory           Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade)
  platform_id         String?
  platform            Platform? @relation(fields: [platform_id], references: [id])
  buyer_id            String?
  buyer               Buyer?    @relation(fields: [buyer_id], references: [id])
  quantity            Int
  unit_price          Float
  unit_price_decimal  Decimal?  @db.Decimal(19, 2)
  commission_fee      Float     @default(0)
  commission_fee_decimal Decimal? @db.Decimal(19, 2)
  sale_shipping       Float     @default(0)
  sale_shipping_decimal Decimal? @db.Decimal(19, 2)
  sale_date           DateTime
  // User-entered "expected payout" reminder. Not a payment confirmation --
  // that is paid_at/paid_amount/paid_reference below.
  payout_date         DateTime?
  status              String    @default("SOLD")
  // Status-workflow rework (additive). workflow_type is copied from the
  // platform's preset when the sale is created, so changing a platform's
  // preset later never rewrites old sales.
  workflow_type       String?
  workflow_status     String?
  delivered_at        DateTime?
  paid_at             DateTime?
  paid_amount         Decimal?  @db.Decimal(19, 2)
  paid_reference      String?
  cancelled_at        DateTime?
  voided_at           DateTime?
  return_requested_at DateTime?
  returned_at         DateTime?
  disputed_at         DateTime?
  taxable             Boolean   @default(true)
  sale_tax_collected  Float     @default(0)
  sale_tax_collected_decimal Decimal? @db.Decimal(19, 2)
  customer_tax_exempt Boolean   @default(false)
  exemption_type      String?
  tracking_number     String?
  tracking_info       Json?

  @@index([inventory_id])
  @@index([platform_id])
  @@index([sale_date])
  @@index([buyer_id])
}

model Platform {
  id               String      @id @default(uuid())
  user_id          String
  user             User        @relation(fields: [user_id], references: [id])
  name             String
  type             String      // "Marketplace, Cashout, Vendor"
  fee_pct          Float       @default(0)
  fee_pct_decimal  Decimal?    @db.Decimal(9, 6)
  address          String?
  notes            String?
  tax_exempt_place Boolean     @default(false)
  // Default sale workflow for new sales on this platform (status-workflow
  // rework, additive). Separate from `type` above, whose live values
  // ('Vendor' | 'Marketplace' | 'Cashout') other screens already depend on.
  workflow_preset  String?
  inventories      Inventory[] // Platforms as vendors
  sales            Sales[]     // Platforms as marketplaces
  accounts         Account[]

  @@index([user_id])
}

model Account {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  platform_id String
  platform    Platform @relation(fields: [platform_id], references: [id], onDelete: Cascade)
  name        String
  email       String?
  username    String?
  status      String   @default("Active")
  notes       String?

  @@index([user_id])
}

model Buyer {
  id                 String    @id @default(uuid())
  user_id            String
  user               User      @relation(fields: [user_id], references: [id])
  name               String
  avg_days_to_payout Int?
  sales              Sales[]
  invoices           Invoice[]

  @@index([user_id])
  @@unique([id, user_id])
}

model PaymentMethod {
  id                    String      @id @default(uuid())
  user_id               String
  user                  User        @relation(fields: [user_id], references: [id])
  name                  String      // "e.g. Amex Blue"
  type                  String      // "Credit, Debit"
  default_cashback_rate Float       @default(0)
  default_cashback_rate_decimal Decimal? @db.Decimal(9, 6)
  preset_card_id        String?     // matches PRESET_CARDS[].id in presetCards.js
  category_rates        String?     // JSON array: [{store, rate, expires?}]
  statement_close_day   Int?        // day of month statement closes (1–28)
  due_day               Int?        // day of month payment is due (1–28)
  credit_limit          Float?      // total credit limit on the card
  credit_limit_decimal  Decimal?    @db.Decimal(19, 2)
  min_payment_pct       Float?      // minimum payment as % of balance (e.g. 2.0 = 2%)
  min_payment_pct_decimal Decimal?  @db.Decimal(9, 6)
  inventories           Inventory[]
  expenses              Expense[]
  recurring_expenses    RecurringExpense[]
}

model Expense {
  id                   String            @id @default(uuid())
  user_id              String
  user                 User              @relation(fields: [user_id], references: [id])
  name                 String
  amount               Float
  amount_decimal       Decimal?          @db.Decimal(19, 2)
  category             String?
  date                 DateTime
  notes                String?
  receipt_url          String?
  recurring_expense_id String?
  recurring_expense    RecurringExpense? @relation(fields: [recurring_expense_id], references: [id], onDelete: SetNull)
  payment_method_id    String?
  payment_method       PaymentMethod?    @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  tax_details          Json?
  tax_version          Int               @default(0)

  @@index([user_id])
  @@index([user_id, date])
  @@unique([recurring_expense_id, date])
}

model RecurringExpense {
  id               String    @id @default(uuid())
  user_id          String
  user             User      @relation(fields: [user_id], references: [id])
  name             String
  amount           Float
  amount_decimal   Decimal?  @db.Decimal(19, 2)
  category         String?
  frequency        String    // "weekly" | "biweekly" | "monthly"
  start_date       DateTime
  end_date         DateTime?
  active           Boolean   @default(true)
  notes            String?
  last_generated   DateTime?
  payment_method_id String?
  payment_method   PaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull)
  generated_entries Expense[]
}

model Invoice {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  buyer_id     String
  buyer        Buyer    @relation(fields: [buyer_id, user_id], references: [id, user_id])
  issue_date   DateTime
  due_date     DateTime
  total_amount Float
  total_amount_decimal Decimal? @db.Decimal(19, 2)
  status       String   // "Paid, Unpaid"

  @@index([user_id])
}

model Goal {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  metric       String            // 'netProfit' | 'totalRevenue' | 'unitsSold'
  target_7d    Float?            // target for 7-day period
  target_7d_decimal Decimal?     @db.Decimal(19, 2) // NULL when metric = 'unitsSold' (a count, not money)
  target_30d   Float?            // target for 30-day period
  target_30d_decimal Decimal?    @db.Decimal(19, 2)
  target_ytd   Float?            // target for year-to-date period
  target_ytd_decimal Decimal?    @db.Decimal(19, 2)
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  @@index([user_id])
}

model ProductNote {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  product_name String   // stored lowercase-trimmed for case-insensitive matching
  note         String
  updated_at   DateTime @updatedAt

  @@unique([user_id, product_name])
  @@index([user_id])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  title       String
  date        String   // YYYY-MM-DD (local date, no TZ shift)
  end_date    String?  // optional multi-day end (YYYY-MM-DD)
  type        String   @default("manual")
  color       String?  // "purple"|"blue"|"green"|"amber"|"red"
  notes       String?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([user_id, date])
}

model EbayPriceCache {
  product_name   String   @id
  last_sold_price Float?
  last_sold_price_decimal Decimal? @db.Decimal(19, 2)
  currency       String   @default("USD")
  fetched_at     DateTime @updatedAt

  @@map("ebay_price_cache")
}

/// Managed by connect-pg-simple — Prisma should not touch this table
model user_sessions {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@ignore
}
