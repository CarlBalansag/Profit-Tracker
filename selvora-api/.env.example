# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL (Neon) connection string for production
# Get from: neon.tech → your project → Connect
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Discord OAuth — create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_CALLBACK_URL="http://localhost:3000/auth/discord/callback"

# Sessions — use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET="replace_with_a_strong_random_secret"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL — used for CORS and OAuth redirects
FRONTEND_URL="http://localhost:5173"

# Cloudinary — receipt image storage (free at cloudinary.com)
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
