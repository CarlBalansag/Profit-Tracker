# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# URL of the backend API server.
# In production, leave VITE_API_URL empty when using Netlify redirects (see netlify.toml).
VITE_API_URL=http://localhost:3000

# Public Firebase web configuration — the app's only login method. NEVER put a service-account private key here.
VITE_FIREBASE_AUTH_ENABLED=true
VITE_FIREBASE_SIGNUP_ENABLED=true
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# LOCAL TESTS ONLY: VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
