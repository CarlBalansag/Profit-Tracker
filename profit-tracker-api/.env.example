# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL (Neon) connection string for production
# Get from: neon.tech → your project → Connect
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Sessions — use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET="replace_with_a_strong_random_secret"

# Server
PORT=3000
NODE_ENV=development

# Admin users — comma-separated emails allowed to generate invites and access admin features
ADMIN_EMAILS=

# Frontend URL — used for CORS and auth redirects
FRONTEND_URL="http://localhost:5173"

# Firebase Auth — the app's only login method (Discord OAuth has been retired).
# Admin SDK 14 requires Node >=22. Web config belongs in the frontend; private keys do not.
FIREBASE_AUTH_ENABLED=true
FIREBASE_SIGNUP_ENABLED=true
FIREBASE_PROJECT_ID=
# Render SECRET: service-account JSON for this exact project, or supported application-default credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# LOCAL TESTS ONLY: FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (production refuses startup).

# Cloudinary — receipt image storage (free at cloudinary.com)
# Get from: cloudinary.com → Dashboard
# Also stores the private, stable ICS files used by Calendar subscriptions.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Shipping tracking — all optional. Any carrier left blank shows a
# "not configured" fallback (open the carrier's tracking page) instead of a live status.
# UPS: register at https://developer.ups.com (OAuth Client Credentials app)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# FedEx: register at https://developer.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# USPS: register at https://developers.usps.com — note USPS restricts free access to
# tracking numbers generated under your own Mailer ID as of April 2026.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# Cashout integrations (EB, etc.)
# 32-byte key (64 hex characters or 32-char string) for encrypting stored third-party cashout API keys with AES-256-GCM
CASHOUT_KEY_ENCRYPTION_KEY=
# Bearer secret token required to invoke the background sync endpoint (POST /internal/cashouts/sync)
CASHOUT_SYNC_SECRET=
# LA deals from Discord (optional). Follow LA's deals channels (#above-cost-deals,
# #close-to-cost-deals) into your own server, add the bot there, and list those
# channel IDs. Read once a minute by the cashout sync above.
DISCORD_BOT_TOKEN=
DISCORD_DEAL_CHANNELS=
# Comma-separated user UUIDs who have access to non-public / beta cashout integrations
CASHOUT_BETA_USER_IDS=

# Phone push notifications (To-Do summary, reminder alerts, urgent alerts).
# All three blank = notifications off; Settings > Notifications says so.
# Generate the pair once with: npx web-push generate-vapid-keys
# Keep the same pair forever: changing it signs every phone out of notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com or your site's https URL.
VAPID_SUBJECT=
# Bearer secret for POST /internal/notifications/run. Call it every 5 minutes
# from an outside cron (cron-job.org, a Render Cron Job, ...) with the header
#   Authorization: Bearer <this value>
NOTIFICATIONS_CRON_SECRET=

# Email connections (Settings > Email). Leave both blank to keep the feature
# switched off: the Email tab then says it isn't turned on, and nothing syncs.
# 32-byte key (64 hex characters, e.g. openssl rand -hex 32) that encrypts the
# saved mail app passwords with AES-256-GCM. Separate from the cashout key.
# Keep the same value forever: changing it makes every connected mailbox ask
# for its password again.
EMAIL_TOKEN_KEY=
# Bearer secret for POST /internal/email/sync (and GET /internal/email/store-requests).
# Call the sync every 10-15 minutes from an outside cron (cron-job.org, ...) with
#   Authorization: Bearer <this value>
# It answers within 20 seconds: 200 with a summary, or 202 while a long run
# carries on in the background. Both mean it worked.
EMAIL_SYNC_SECRET=

# Optional request limits per 15 minutes (middleware/rateLimiters.js).
# API_RATE_LIMIT is per signed-in user (default 1500); MCP_RATE_LIMIT is per
# AI-assistant API key (default 1200). Leave unset to use the defaults.
API_RATE_LIMIT=
MCP_RATE_LIMIT=
