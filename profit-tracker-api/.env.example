# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL (Neon) connection string for production
# Get from: neon.tech → your project → Connect
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Sessions — use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET="replace_with_a_strong_random_secret"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL — used for CORS and auth redirects
FRONTEND_URL="http://localhost:5173"

# Firebase Auth — the app's only login method (Discord OAuth has been retired).
# Admin SDK 14 requires Node >=22. Web config belongs in the frontend; private keys do not.
FIREBASE_AUTH_ENABLED=true
FIREBASE_SIGNUP_ENABLED=true
FIREBASE_PROJECT_ID=
# Render SECRET: service-account JSON for this exact project, or supported application-default credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# LOCAL TESTS ONLY: FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (production refuses startup).

# Cloudinary — receipt image storage (free at cloudinary.com)
# Get from: cloudinary.com → Dashboard
# Also stores the private, stable ICS files used by Calendar subscriptions.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Shipping tracking — all optional. Any carrier left blank shows a
# "not configured" fallback (open the carrier's tracking page) instead of a live status.
# UPS: register at https://developer.ups.com (OAuth Client Credentials app)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# FedEx: register at https://developer.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# USPS: register at https://developers.usps.com — note USPS restricts free access to
# tracking numbers generated under your own Mailer ID as of April 2026.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
